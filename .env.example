# HookLab — local development

DATABASE_URL="postgresql://hooklab:hooklab@127.0.0.1:5432/hooklab?schema=public"
REDIS_URL=redis://127.0.0.1:6379

# 32-byte key as 64 hex characters (AES-256-GCM for endpoint signing secrets)
ENDPOINT_SECRET_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

API_HOST=127.0.0.1
API_PORT=3000
API_RATE_LIMIT_MAX=120
API_RATE_LIMIT_WINDOW=1 minute
RATE_LIMIT_ENABLED=1
# Dashboard (Vite on 5173); API enables CORS unless DASHBOARD_CORS=0
DASHBOARD_CORS_ORIGIN=http://127.0.0.1:5173

# From `npm run db:seed` output (Bearer token)
HOOKLAB_API_KEY=hl_live_replace_after_seed
HOOKLAB_API_URL=http://127.0.0.1:3000

CONSUMER_HOST=127.0.0.1
CONSUMER_PORT=4000
# Must match signingSecret from POST /api/v1/endpoints response
WEBHOOK_SIGNING_SECRET=replace_with_endpoint_signing_secret
WEBHOOK_TIMESTAMP_TOLERANCE_SECONDS=300
# Dev-only: X-HookLab-Simulate header on consumer
CONSUMER_ENABLE_SIMULATE=1

PROCESSING_LEASE_MS=120000
OUTBOX_PUBLISHING_LEASE_MS=60000
WORKER_RECOVERY_INTERVAL_MS=30000
# Required for local consumer URL registration (default off in production)
WEBHOOK_ALLOW_LOCALHOST=1

WEBHOOK_URL=http://127.0.0.1:4000/webhooks
EVENT_TYPE=task.completed

DELIVERY_TIMEOUT_MS=10000
WORKER_CONCURRENCY=5
OUTBOX_POLL_INTERVAL_MS=1000
OUTBOX_BATCH_SIZE=25
DELIVERY_MAX_ATTEMPTS=5
WORKER_ID=worker_local_1

# Set to 1 when Postgres is running and migrations applied
RUN_INTEGRATION_TESTS=0
