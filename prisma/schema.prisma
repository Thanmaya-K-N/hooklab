generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Organization {
  id          String   @id
  name        String
  apiKeyHash  String   @unique @map("api_key_hash")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  endpoints          WebhookEndpoint[]
  events             Event[]
  deliveries         WebhookDelivery[]
  idempotencyRecords IdempotencyRecord[]

  @@map("organizations")
}

model WebhookEndpoint {
  id               String   @id
  organizationId   String   @map("organization_id")
  url              String
  description      String?
  secretCiphertext String   @map("secret_ciphertext")
  subscribedEvents String[] @map("subscribed_events")
  enabled          Boolean  @default(true)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId])
  @@map("webhook_endpoints")
}

model Event {
  id             String   @id
  organizationId String   @map("organization_id")
  eventType      String   @map("event_type")
  payload        Json
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  deliveries   WebhookDelivery[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@map("events")
}

model WebhookDelivery {
  id             String    @id
  organizationId String    @map("organization_id")
  eventId        String    @map("event_id")
  endpointId     String    @map("endpoint_id")
  status         String
  attemptCount   Int       @default(0) @map("attempt_count")
  responseStatus Int?      @map("response_status")
  responseBody   String?   @map("response_body")
  errorMessage   String?   @map("error_message")
  deliveredAt    DateTime? @map("delivered_at")
  nextRetryAt    DateTime? @map("next_retry_at")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  event        Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  endpoint     WebhookEndpoint   @relation(fields: [endpointId], references: [id], onDelete: Cascade)
  attempts     DeliveryAttempt[]
  outboxEvents OutboxEvent[]

  @@index([organizationId, createdAt(sort: Desc)])
  @@index([organizationId, status, createdAt(sort: Asc)])
  @@index([eventId])
  @@index([endpointId])
  @@map("webhook_deliveries")
}

model DeliveryAttempt {
  id                 String    @id
  deliveryId         String    @map("delivery_id")
  attemptNumber      Int       @map("attempt_number")
  requestTimestamp   DateTime  @map("request_timestamp")
  responseTimestamp  DateTime? @map("response_timestamp")
  responseStatus     Int?      @map("response_status")
  responseBody       String?   @map("response_body")
  errorMessage       String?   @map("error_message")
  durationMs         Int?      @map("duration_ms")
  createdAt          DateTime  @default(now()) @map("created_at")

  delivery WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@unique([deliveryId, attemptNumber])
  @@index([deliveryId, attemptNumber])
  @@map("delivery_attempts")
}

model OutboxEvent {
  id          String    @id
  deliveryId  String    @map("delivery_id")
  status      String
  availableAt DateTime  @default(now()) @map("available_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  publishedAt DateTime? @map("published_at")

  delivery WebhookDelivery @relation(fields: [deliveryId], references: [id], onDelete: Cascade)

  @@index([status, availableAt, createdAt])
  @@index([deliveryId])
  @@map("outbox_events")
}

model IdempotencyRecord {
  organizationId String   @map("organization_id")
  idempotencyKey String   @map("idempotency_key")
  eventId        String   @map("event_id")
  response       Json
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@id([organizationId, idempotencyKey])
  @@map("idempotency_records")
}
