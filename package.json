{
  "name": "hooklab",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted webhook delivery platform",
  "workspaces": [
    "apps/*",
    "packages/*",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "postinstall": "prisma generate",
    "dev:api": "npm run dev -w @hooklab/api",
    "dev:worker": "npm run dev -w @hooklab/worker",
    "dev:dispatcher": "npm run dev -w @hooklab/dispatcher",
    "dev:consumer": "npm run dev -w @hooklab/webhook-consumer",
    "dev:producer": "npm run dev -w @hooklab/event-producer",
    "dev:dashboard": "npm run dev -w @hooklab/dashboard",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration -w @hooklab/api",
    "typecheck": "npm run typecheck --workspaces --if-present"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@hooklab/shared": "0.1.0",
    "@prisma/client": "^6.1.0"
  },
  "devDependencies": {
    "prisma": "^6.1.0",
    "tsx": "^4.19.2"
  },
  "engines": {
    "node": ">=20"
  }
}
